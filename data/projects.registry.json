[
  {
    "id": "code-control",
    "name": "Code Control",
    "description": "Schema, conventions, and guided codegen into customer repos",
    "repos": [
      {
        "repoType": "express",
        "repoName": "code-control-express-server",
        "defaultApiPort": 3012,
        "healthPath": "/api/health",
        "role": "express"
      },
      {
        "repoType": "storage-express",
        "repoName": "code-generator-storage-server",
        "defaultApiPort": 3080,
        "healthPath": "/api/storage/health",
        "role": "storage"
      },
      {
        "repoType": "nextjs",
        "repoName": "code-control",
        "defaultWebPortStart": 3013,
        "role": "web"
      }
    ],
    "localDatabase": {
      "kind": "postgres",
      "databaseName": "code_control",
      "migrationsDir": "migrations",
      "migrationFiles": [
        "000_helpers.sql",
        "000a_create_customers.sql",
        "001_workspaces_and_projects.sql"
      ],
      "expectedTables": [
        "customers",
        "customer_projects",
        "customer_project_repos"
      ],
      "envRepo": "storage-express",
      "postgres": {
        "host": "127.0.0.1",
        "port": 5432,
        "formula": "postgresql@16",
        "installCommand": "brew install postgresql@16",
        "startCommand": "brew services start postgresql@16",
        "stopCommand": "brew services stop postgresql@16"
      }
    },
    "dataPlane": {
      "modeKey": "STORAGE_ACCESS_MODE",
      "options": [
        {
          "id": "direct",
          "label": "Direct storage",
          "value": "direct",
          "keys": [
            "CODE_CONTROL_STORAGE_URL",
            "CODE_CONTROL_STORAGE_SECRET",
            "CODE_CONTROL_DIRECT_URL",
            "CODE_CONTROL_DIRECT_SECRET"
          ]
        },
        {
          "id": "gateway",
          "label": "Studio gateway",
          "value": "gateway",
          "keys": [
            "MAIN_GATEWAY_URL",
            "MAIN_GATEWAY_PROJECT_ID",
            "DISPATCHER_GATE_SECRET"
          ]
        }
      ]
    }
  },
